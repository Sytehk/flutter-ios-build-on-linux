#!/bin/sh
set -eu

apple_target=false
explicit_target=false
compile_only=false
for argument do
  case "$argument" in
    *-apple-ios*|*/iPhoneOS*.sdk) apple_target=true ;;
  esac
  case "$argument" in
    -target|--target|--target=*) explicit_target=true ;;
    -c|-S|-E) compile_only=true ;;
  esac
done

if "$apple_target"; then
  if ! "$explicit_target"; then
    set -- --target=arm64-apple-ios15.0 "$@"
  fi
  if ! "$compile_only"; then
    shim_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    set -- "--ld-path=$shim_dir/ld64.lld" -mlinker-version=609 "$@"
  fi
fi

exec /usr/bin/clang "$@"
